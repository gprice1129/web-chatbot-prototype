{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "./build",
    // Stated rather than discovered: this package is built by two TypeScript
    // versions -- its own and the chatbot's, which pins a newer major -- and
    // only one of them finds @types/node on its own.
    "types": ["node"]
  },
  "references": [
    { "path": "../common" }
  ],
  "include": ["src/**/*.ts"]
}
