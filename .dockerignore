# Keep secrets out of build context
.env*
secrets/

# Version control and tooling
.git
.gitignore

# Dependencies and build output — reinstalled / rebuilt inside the image
node_modules
**/node_modules
**/build
**/dist
**/*.tsbuildinfo

# Test fixtures and artifacts
packages/test/*
**/playwright-report/
**/test-results/

# Misc
plan/**

# Knowledge base: bind-mounted at runtime, never baked into an image
config/knowledge_base/
config/docker/config.local.json
