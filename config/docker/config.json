{
  "anthropic": {
    "base_url": "https://api.anthropic.com"
  },
  "postgres": {
    "superuser": "postgres",
    "app_user": "aim_hi_user",
    "app_database": "aim_hi_db"
  },
  "app": {
    "auth_mode": "real",
    "model_mode": "real",
    "files_base_path": "/var/lib/aim_hi/uploads",
    "trust_proxy": false
  },
  "nginx": {
    "server_name": "your.domain.com"
  },
  "frontend": {
    "base_path": "/",
    "api_url": "/api"
  },
  "secrets_dir": "./secrets",
  "knowledge_base": {
    "root": "./config/knowledge_base"
  },
  "rate_limits": {
    "login": {
      "max": 5,
      "window": "1 minute"
    },
    "ally": {
      "max": 30,
      "window": "1 minute"
    },
    "grant_review": {
      "max": 10,
      "window": "1 hour"
    }
  },
  "login_limits": {
    "username_max_length": 64,
    "password_max_length": 256,
    "body_limit": 4096
  },
  "models": {
    "ally": {
      "effort": null,
      "thinking": null,
      "caching": null,
      "max_tokens": null
    },
    "grant_review": {
      "effort": null,
      "thinking": null,
      "caching": null,
      "max_tokens": null
    },
    "summary": {
      "effort": null,
      "thinking": null,
      "caching": null,
      "max_tokens": null
    }
  }
}
