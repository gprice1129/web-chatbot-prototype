{
  "anthropic": {
    "base_url": "https://pmi-aim-hi-resource.services.ai.azure.com/anthropic/"
  },
  "postgres": {
    "superuser": "postgres",
    "app_user": "aim_hi_user",
    "app_database": "aim_hi_db"
  },
  "app": {
    "auth_mode": "real",
    "model_mode": "real",
    "debug_mode": false,
    "files_base_path": "/var/lib/aim_hi/uploads",
    "trust_proxy": 2
  },
  "nginx": {
    "server_name": "pmi.might.net"
  },
  "frontend": {
    "base_path": "/aimhi/",
    "api_url": "/aimhi/api"
  },
  "secrets_dir": "/etc/aim-hi/secrets",
  "sources": {
    "knowledge": "./packages/static/knowledge",
    "prompts": "./packages/static/prompts"
  },
  "rate_limits": {
    "login": {
      "max": 5,
      "window": "1 minute"
    },
    "ally": {
      "max": 30,
      "window": "1 minute"
    },
    "grant_review": {
      "max": 10,
      "window": "1 hour"
    }
  },
  "login_limits": {
    "username_max_length": 64,
    "password_max_length": 256,
    "body_limit": 4096
  },
  "models": {
    "ally": {
      "effort": null,
      "thinking": null,
      "caching": null,
      "max_tokens": null
    },
    "grant_review": {
      "effort": null,
      "thinking": null,
      "caching": null,
      "max_tokens": null
    },
    "summary": {
      "effort": null,
      "thinking": null,
      "caching": null,
      "max_tokens": null
    }
  }
}
